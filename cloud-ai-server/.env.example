# Vaachak Cloud AI Server — Environment Variables
# Copy this file to .env and fill in your keys

GOOGLE_API_KEY=your_google_gemini_api_key_here
SARVAM_API_KEY=your_sarvam_platform_api_key_here

# Optional: Backboard memory playground
BACKBOARD_API_KEY=

# Supabase database playground (server only)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
